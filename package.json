{
  "name": "apex-ssh",
  "version": "0.1.3",
  "private": true,
  "description": "Apex SSH 客户端",
  "author": {
    "name": "dunhanson",
    "email": "dunhanson@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunhanson/apex-ssh.git"
  },
  "homepage": "https://github.com/dunhanson/apex-ssh#readme",
  "packageManager": "pnpm@11.17.0",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "dist": "pnpm run dist:win",
    "dist:win": "pnpm run icon && electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist:win:all": "pnpm run icon && electron-vite build && electron-builder --win nsis --x64 --arm64 --publish never",
    "dist:linux": "pnpm run icon && electron-vite build && electron-builder --linux deb rpm --x64 --arm64 --publish never && node scripts/统一Linux安装包名称.mjs",
    "icon": "node scripts/generate-icon.js",
    "icon:mac": "pnpm run icon && bash scripts/生成macOS图标.sh",
    "dist:mac": "pnpm run icon:mac && electron-vite build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "site.dunhanson.apex",
    "productName": "Apex SSH",
    "icon": "resources/icon.png",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dunhanson",
        "repo": "apex-ssh"
      }
    ],
    "files": [
      "out/**",
      "resources/**",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Apex-SSH-${version}-Windows-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Network",
      "icon": "resources/icon.png",
      "artifactName": "Apex-SSH-${version}-Linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "artifactName": "Apex-SSH-${version}-macOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Apex SSH",
      "buildUniversalInstaller": false
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "i18next": "^26.5.5",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.2",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "43.8.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  }
}
